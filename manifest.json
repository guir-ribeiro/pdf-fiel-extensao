{
  "manifest_version": 3,
  "name": "PDF Fiel — página inteira",
  "version": "1.0.0",
  "description": "Baixa a página web inteira em PDF preservando a aparência original, com carimbo opcional de data, hora e URL.",
  "permissions": [
    "activeTab",
    "scripting",
    "debugger",
    "downloads",
    "storage",
    "offscreen"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Baixar página em PDF",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "capturar-pdf": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Baixar a página atual em PDF com as últimas opções usadas"
    }
  }
}
